# MongoDB Atlas connection string.
# On the Deakin campus network, use the NON-SRV form (mongodb://host1,host2,host3/mop_database?...)
# because SRV DNS resolution fails there (querySrv ECONNREFUSED).
MONGODB_URI=

# Secret used to sign auth JWTs. Generate a strong random value, e.g. `openssl rand -base64 32`.
JWT_SECRET=

# SMTP / Nodemailer (contact form + password-reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Absolute base URL used to build the password-reset link in forgot-password emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud Storage — private bucket for blog covers (blogs/) and gallery images (gallery/).
# Served via /api/images/[...path] (browser can't reach the private bucket directly).
# Auth via Workload Identity Federation on Cloud Run — no key file needed.
GCS_IMAGES_BUCKET=
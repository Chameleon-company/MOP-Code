# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# environment secrets (never commit real secrets)
.env
.env.*
!.env.example

# testing artefacts
/coverage
/cypress/videos
/cypress/screenshots
/cypress/downloads


# typescript
*.tsbuildinfo
next-env.d.ts

# VS Code workspace settings (keep extensions.json & settings.json if shared)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# vercel
.vercel
# Lighthouse CI reports
/.lighthouseci/
/lighthouse-reports/

    "_**DELETE BEFORE PUBLISHING**_\n",
    "\n",
    "_This is the MOP usecase template and style guide. The styling uses the usecase CSS when uploaded to the website, which will not be visible on your local machine unless the fonts below are installed._\n",
    "\n",
    "_Change any text marked with {} and delete any cells marked DELETE._\n",
    "\n",
    "_**Rules for this template**_\n",
    "- _Every section heading must be numbered automatically (no need to type numbers yourself) — sections are numbered 1., 2., 3.; subsections 1.1., 1.2.; sub-subsections 1.1.1., 1.1.2. etc._\n",
    "- _Every heading (at any level) must have a one-line description directly underneath it, before any other content — use the `usecase-heading-description` style shown below._\n",
    "- _A contents page is required, placed after Key Takeaways and before your actual analysis/code content begins._\n",
    "- _The MOP logo does not need to be included in the usecase itself — it will already appear on the website page. Do not include a logo image here._\n",
    "- _See the Example section below for exact structuring, numbering and descriptions should look in practice._\n",
    "\n",
    "***"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "# DELETE BEFORE PUBLISHING\n",
    "# This is just here so you can preview the styling on your local machine\n",
    "\n",
    "from IPython.core.display import HTML\n",
    "HTML(\"\"\"\n",
    "<style>\n",
    "@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500&display=swap');\n",
    "\n",
    "body {\n",
    "    counter-reset: h2counter;\n",
    "    font-family: 'Inter', sans-serif;\n",
    "}\n",
    "\n",
    ".usecase-header-bar {\n",
    "    padding: 16px 20px;\n",
    "    background-color: #059669;\n",
    "    color: #fff;\n",
    "    border-radius: 6px 6px 0 0;\n",
    "}\n",
    "\n",
    ".usecase-title {\n",
    "    font-family: 'Poppins', sans-serif;\n",
    "    font-size: 1.7em;\n",
    "    font-weight: 700;\n",
    "}\n",
    "\n",
    ".usecase-authors, .usecase-level, .usecase-skill {\n",
    "    font-family: 'Inter', sans-serif;\n",
    "    padding-left: 20px;\n",
    "    padding-bottom: 8px;\n",
    "    padding-top: 8px;\n",
    "    background-color: rgba(5, 150, 105, 0.08);\n",
    "    font-size: 1.1em;\n",
    "    color: #121212;\n",
    "}\n",
    "\n",
    ".usecase-date {\n",
    "    font-family: 'Inter', sans-serif;\n",
    "    padding-left: 20px;\n",
    "    padding-bottom: 8px;\n",
    "    background-color: rgba(5, 150, 105, 0.08);\n",
    "    font-size: 0.95em;\n",
    "    color: rgba(18, 18, 18, 0.65);\n",
    "}\n",
    "\n",
    ".usecase-level-skill {\n",
    "    display: flex;\n",
    "}\n",
    "\n",
    ".usecase-level, .usecase-skill {\n",
    "    width: 50%;\n",
    "}\n",
    "\n",
    ".usecase-duration, .usecase-skill {\n",
    "    text-align: right;\n",
    "    padding-right: 20px;\n",
    "    font-size: 1.1em;\n",
    "    font-family: 'Inter', sans-serif;\n",
    "}\n",
    "\n",
    "/* Level 1 - numbered sections, e.g. 1. */\n",
    ".usecase-section-header {\n",
    "    font-family: 'Poppins', sans-serif;\n",
    "    font-weight: 700;\n",
    "    font-size: 1.35em;\n",
    "    color: #059669;\n",
    "    padding: 14px 4px 6px 4px;\n",
    "    border-bottom: 3px solid #2DBE6C;\n",
    "    margin-top: 10px;\n",
    "    counter-increment: h2counter;\n",
    "    counter-reset: h3counter;\n",
    "}\n",
    "\n",
    ".usecase-section-header::before {\n",
    "    content: counter(h2counter) \". \";\n",
    "}\n",
    "\n",
    "/* Level 2 - numbered subsections, e.g. 1.1. */\n",
    ".usecase-subsection-header {\n",
    "    font-family: 'Poppins', sans-serif;\n",
    "    font-weight: 600;\n",
    "    font-size: 1.15em;\n",
    "    color: #1F8F50;\n",
    "    margin-top: 8px;\n",
    "    counter-increment: h3counter;\n",
    "    counter-reset: h4counter;\n",
    "}\n",
    "\n",
    ".usecase-subsection-header::before {\n",
    "    content: counter(h2counter) \".\" counter(h3counter) \". \";\n",
    "}\n",
    "\n",
    "/* Level 3 - numbered sub-subsections, e.g. 1.1.1. */\n",
    ".usecase-subsubsection-header {\n",
    "    font-family: 'Poppins', sans-serif;\n",
    "    font-weight: 600;\n",
    "    font-size: 1.05em;\n",
    "    color: #15803D;\n",
    "    margin-top: 6px;\n",
    "    counter-increment: h4counter;\n",
    "}\n",
    "\n",
    ".usecase-subsubsection-header::before {\n",
    "    content: counter(h2counter) \".\" counter(h3counter) \".\" counter(h4counter) \". \";\n",
    "}\n",
    "\n",
    ".usecase-subsection-blurb {\n",
    "    font-family: 'Poppins', sans-serif;\n",
    "    font-weight: 600;\n",
    "    font-size: 1em;\n",
    "    font-style: italic;\n",
    "    color: #1F8F50;\n",
    "}\n",
    "\n",
    "/* Required description line under every heading */\n",
    ".usecase-heading-description {\n",
    "    font-family: 'Inter', sans-serif;\n",
    "    font-style: italic;\n",
    "    font-size: 0.95em;\n",
    "    color: rgba(18, 18, 18, 0.65);\n",
    "    margin-bottom: 8px;\n",
    "}\n",
    "\n",
    ".usecase-key-takeaways {\n",
    "    background-color: rgba(34, 197, 94, 0.10);\n",
    "    border-left: 4px solid #22C55E;\n",
    "    padding: 12px 18px;\n",
    "    border-radius: 4px;\n",
    "    font-family: 'Inter', sans-serif;\n",
    "}\n",
    "\n",
    "/* Contents page - not numbered, sits outside the section counter */\n",
    ".usecase-toc-title {\n",
    "    font-family: 'Poppins', sans-serif;\n",
    "    font-weight: 700;\n",
    "    font-size: 1.35em;\n",
    "    color: #059669;\n",
    "    padding: 14px 4px 6px 4px;\n",
    "    border-bottom: 3px solid #2DBE6C;\n",
    "    margin-top: 10px;\n",
    "}\n",
    "\n",
    ".usecase-contents {\n",
    "    font-family: 'Inter', sans-serif;\n",
    "    line-height: 1.9;\n",
    "    padding-left: 20px;\n",
    "}\n",
    "\n",
    ".usecase-contents a {\n",
    "    color: #059669;\n",
    "    text-decoration: none;\n",
    "}\n",
    "\n",
    ".usecase-code-divider {\n",
    "    font-family: 'Inter', sans-serif;\n",
    "    font-style: italic;\n",
    "    color: rgba(18, 18, 18, 0.65);\n",
    "    background-color: rgba(5, 150, 105, 0.06);\n",
    "    padding: 10px 16px;\n",
    "    border-radius: 4px;\n",
    "    margin-top: 14px;\n",
    "}\n",
    "\n",
    "body, p, li {\n",
    "    font-family: 'Inter', sans-serif;\n",
    "}\n",
    "</style>\n",
    "\n",
    "\"\"\")"
   ]
  },
